{
  "name": "budgetisation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:architecture": "node scripts/check-architecture-imports.mjs",
    "check:product-completeness": "node scripts/check-product-completeness.mjs",
    "check:analysis-month-contracts": "node --experimental-strip-types scripts/check-analysis-month-contracts.mjs",
    "check:analysis-global-contracts": "node scripts/check-analysis-global-contracts.mjs",
    "check:canonical-in-batching": "node scripts/check-canonical-in-batching.mjs",
    "check:calendar-day": "node scripts/check-calendar-day.mjs",
    "check:exploration-entities": "node scripts/check-exploration-entities.mjs",
    "check:live-runtime-regressions": "node scripts/check-live-runtime-regressions.mjs",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "verify": "npm run check:architecture && npm run check:product-completeness && npm run check:analysis-month-contracts && npm run check:analysis-global-contracts && npm run check:canonical-in-batching && npm run check:calendar-day && npm run check:exploration-entities && npm run check:live-runtime-regressions && npm run typecheck && npm run build",
    "start": "next start"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@noble/hashes": "2.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "big.js": "7.0.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/big.js": "7.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
